{
  "name": "isu-stream-server",
  "version": "0.3.0",
  "private": true,
  "description": "ISU Stream Server: capture, one H.264/AAC encode, true disk delay, multi-RTMP(S) fan-out",
  "author": "Idaho State Esports",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke",
    "build": "electron-builder --config electron-builder.json --dir",
    "package": "electron-builder --config electron-builder.json --win portable",
    "test:media": "node test/media/pipeline.e2e.cjs 10 3",
    "test:media:300": "node test/media/pipeline.e2e.cjs 300 3",
    "test:ui-real": "electron test/media/ui-real.e2e.cjs",
    "test:isolation": "node test/media/isolation.e2e.cjs",
    "test:recording": "node test/media/recording.e2e.cjs",
    "test:companion": "node test/media/companion.e2e.cjs",
    "companion:build": "cd companion-module && corepack yarn install && corepack yarn build",
    "companion:package": "cd companion-module && corepack yarn install && corepack yarn package",
    "test:device": "node test/media/device.e2e.cjs",
    "test:preview": "node test/media/preview.e2e.cjs",
    "test:preview-latency": "node test/media/preview-latency.e2e.cjs",
    "test:avsync": "node test/media/avsync.e2e.cjs",
    "buildinfo": "node scripts/build-info.cjs",
    "prestart": "node scripts/build-info.cjs",
    "prebuild": "node scripts/build-info.cjs",
    "prepackage": "node scripts/build-info.cjs"
  }
}
