{
  "appId": "edu.isu.esports.displayclient",
  "productName": "ISU Display Client",
  "directories": {
    "output": "release/display-client"
  },
  "files": [
    "electron/displays/display-client-main.cjs",
    "electron/displays/display-client-preload.cjs",
    "electron/displays/ndi-receiver.cjs",
    "electron/displays/cursor-lock.cjs",
    "electron/displays/client/**/*",
    "package.json",
    "electron/displays/NDI-LICENSE.txt",
    "node_modules/ws/**/*",
    "node_modules/@stagetimerio/grandiose/dist/**/*"
  ],
  "asarUnpack": [
    "node_modules/@stagetimerio/grandiose/dist/**/*"
  ],
  "extraMetadata": {
    "main": "electron/displays/display-client-main.cjs"
  },
  "win": {
    "icon": "build/icon.svg",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "license": "electron/displays/NDI-LICENSE.txt"
  },
  "afterPack": "scripts/check-ndi-bundle.cjs"
}
