{
  "appId": "edu.isu.esports.gamebridge",
  "productName": "ISU Esports Game Bridge",
  "directories": {
    "output": "release/bridge"
  },
  "files": [
    "bridge/**/*",
    "electron/bridge-main.cjs",
    "electron/bridge-preload.cjs",
    "electron/game-bridge.cjs",
    "electron/bridge-link.cjs",
    "electron/rocket-league-service.cjs",
    "electron/valorant-capture.cjs",
    "electron/valorant-native-capture.cjs",
    "electron/valorant-ocr-engine.cjs",
    "package.json",
    "electron/spectate-tracker.cjs",
    "electron/valorant-agent-templates.json",
    "electron/valorant-agent-templates.bin",
    "electron/ocr-models/**/*"
  ],
  "asarUnpack": [
    "node_modules/bmp-js/**/*",
    "node_modules/idb-keyval/**/*",
    "node_modules/is-url/**/*",
    "node_modules/node-fetch/**/*",
    "node_modules/regenerator-runtime/**/*",
    "node_modules/tesseract.js/**/*",
    "node_modules/tesseract.js-core/**/*",
    "node_modules/@tesseract.js-data/eng/**/*",
    "node_modules/@screen-capture/node/**/*",
    "node_modules/@screen-capture/node-win32-x64-msvc/**/*",
    "node_modules/tr46/**/*",
    "node_modules/wasm-feature-detect/**/*",
    "node_modules/webidl-conversions/**/*",
    "node_modules/whatwg-url/**/*",
    "node_modules/zlibjs/**/*",
    "electron/ocr-models/**/*"
  ],
  "extraMetadata": {
    "main": "electron/bridge-main.cjs"
  },
  "win": {
    "icon": "build/icon.svg",
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  }
}