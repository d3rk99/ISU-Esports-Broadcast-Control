{
  "appId": "edu.isu.esports.gamebridge",
  "productName": "ISU Esports Game Bridge",
  "directories": { "output": "release/bridge" },
  "files": [
    "bridge/**/*",
    "electron/bridge-main.cjs",
    "electron/bridge-preload.cjs",
    "electron/game-bridge.cjs",
    "electron/rocket-league-service.cjs",
    "electron/valorant-capture.cjs",
    "electron/valorant-ocr-engine.cjs",
    "electron/valorant-ocr-profiles.cjs",
    "electron/valorant-ocr-profiles.json",
    "electron/valorant-ocr-service.cjs",
    "electron/valorant-ocr-state.cjs",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/tesseract.js/**/*",
    "node_modules/tesseract.js-core/**/*",
    "node_modules/@tesseract.js-data/eng/**/*"
  ],
  "extraMetadata": { "main": "electron/bridge-main.cjs" },
  "win": {
    "icon": "build/icon.svg",
    "target": [{ "target": "portable", "arch": ["x64"] }]
  },
  "portable": { "artifactName": "${productName}-Portable-${version}-${arch}.${ext}" }
}
